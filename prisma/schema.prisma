datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id              String   @id @default(uuid())
  name            String   @unique
  league          String
  homeGoalsAvg    Float    @default(0.0)
  awayGoalsAvg    Float    @default(0.0)
  homeConcededAvg Float    @default(0.0)
  awayConcededAvg Float    @default(0.0)
  homeMatches     Match[]  @relation("HomeTeam")
  awayMatches     Match[]  @relation("AwayTeam")
}

model Match {
  id                String       @id @default(uuid())
  date              DateTime
  league            String
  homeTeamId        String
  awayTeamId        String
  homeTeam          Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam          Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  
  estimatedProbHome Float
  estimatedProbDraw Float
  estimatedProbAway Float
  
  odds              MarketOdd[]
  bets              BetLog[]
  createdAt         DateTime     @default(now())
}

model MarketOdd {
  id                String   @id @default(uuid())
  matchId           String
  match             Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  bookmaker         String
  homeOdd           Float
  drawOdd           Float
  awayOdd           Float
  expectedValueHome Float
  expectedValueDraw Float
  expectedValueAway Float
  updatedAt         DateTime @updatedAt
}

model BetLog {
  id         String   @id @default(uuid())
  matchId    String?
  match      Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  selection  String   @default("")
  bookmaker  String   @default("")
  odd        Float    @default(1.0)
  stake      Float
  kellyStake Float    @default(0.0)
  result     String   @default("PENDING")
  profit     Float    @default(0.0)
  date       DateTime @default(now())
  betType    String   @default("Simples")
  status     String   @default("RED")
  createdAt  DateTime @default(now())

  @@index([date])
}